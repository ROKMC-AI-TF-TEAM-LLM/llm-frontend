# 백엔드 API 주소. 로컬 개발: http://localhost:8080
# 비워 두면 같은 도메인의 /api/v1/... 로 요청 (Vercel 배포 시 vercel.ts rewrites가 백엔드로 프록시)
# Vercel 배포에서는 비워 둘 것 — VITE_ 값은 번들에 그대로 박혀 백엔드 주소가 노출됨
VITE_SERVER_API_URL=

# SSE 스트림 무응답 타임아웃(ms). 이 시간 동안 데이터가 없으면 연결을 끊음. 미설정 시 1200000(20분)
VITE_STREAM_IDLE_MS=

# [Vercel 전용] 프록시 대상 백엔드 호스트 (프로토콜 없이, 예: api.example.com). Vercel 대시보드 env에만 설정
# BACKEND_HOST=
