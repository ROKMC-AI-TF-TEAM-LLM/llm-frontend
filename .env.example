# 백엔드 API 주소. 로컬 개발: http://localhost:8080
# 비워 두면 같은 도메인의 /api/v1/... 로 요청 (Vercel 배포 시 vercel.json rewrites가 백엔드로 프록시)
VITE_SERVER_API_URL=

# SSE 스트림 무응답 타임아웃(ms). 이 시간 동안 데이터가 없으면 연결을 끊음. 미설정 시 1200000(20분)
VITE_STREAM_IDLE_MS=

# (선택) mock 모드의 채팅을 실제 Claude로 응답하게 하려면 .env.mock.local 파일을 만들어 아래 값을 넣는다.
# 키는 개발 서버(npm run dev:mock)에서만 읽으며 브라우저로 나가지 않는다. .env.mock에는 넣지 말 것(저장소에 올라간다).
# ANTHROPIC_API_KEY=
# MOCK_CLAUDE_MODEL=claude-opus-5-5
